diff --git a/spa/plugins/bluez5/meson.build b/spa/plugins/bluez5/meson.build
--- a/spa/plugins/bluez5/meson.build
+++ b/spa/plugins/bluez5/meson.build
@@ -123,14 +123,48 @@
   # adds the qemu-hexagon helper IPC used by the aptx_adaptive entry appended
   # in a2dp-codec-aptx.c. Needs
   # pthread (bridge IO thread) in addition to upstream's aptx_dep/sbc_dep.
+  #
+  # ("meson-derived paths instead of a hardcoded x86_64-linux-gnu
+  # triplet"): the
+  # hardcoded M4_ADAPTIVE_DEFAULT_{LOADER,CAPI}_PATH fallbacks in
+  # a2dp-codec-aptx.c (only ever used when neither the config file nor
+  # M4_ADAPTIVE_{LOADER,CAPI} env vars set a path -- see that file's own
+  # #ifndef guards, already override-friendly) are derived here from
+  # pipewire_libdir (= get_option('prefix') / get_option('libdir'), set by
+  # the top-level meson.build) instead of a literal "/usr/lib/
+  # x86_64-linux-gnu/..." -- portable to any libdir (lib64, lib/aarch64-
+  # linux-gnu, a non-root --prefix, ...), not just Debian amd64.
+  m4_adaptive_hexagon_dir = pipewire_libdir / 'momentum4' / 'hexagon'
+  m4_adaptive_args = codec_args + [
+    '-DM4_ADAPTIVE_DEFAULT_LOADER_PATH="' + (m4_adaptive_hexagon_dir / 'hx_adaptive_loader') + '"',
+    '-DM4_ADAPTIVE_DEFAULT_CAPI_PATH="' + (m4_adaptive_hexagon_dir / 'capi_v2_aptX_CLHDADV_Encoder.so') + '"',
+  ]
   bluez_codec_aptx = shared_library('spa-codec-bluez5-aptx',
     [ 'a2dp-codec-aptx.c', 'media-codecs.c', 'm4-adaptive-bridge.c',
       'm4-adaptive-heartbeat.c', 'm4-adaptive-config.c' ],
     include_directories : [ configinc ],
-    c_args : codec_args,
+    c_args : m4_adaptive_args,
     dependencies : [ spa_dep, aptx_dep, sbc_dep, pthread_lib ],
     install : true,
     install_dir : spa_plugindir / 'bluez5')
+
+  # (BUILD-INFO is written next to the .so and read by `momentum4 doctor`):
+  # prepare-tree.sh (this project's own tree-prep script, NOT part of
+  # upstream PipeWire) generates spa/plugins/bluez5/BUILD-INFO with the
+  # PipeWire version/tarball hash this tree was built from, a hash of the
+  # exact patches/*.patch set applied, and a hash of m4-src/*.{c,h} -- see
+  # its own header comment for the exact format. install_data() puts it in
+  # the SAME directory as libspa-codec-bluez5-aptx.so
+  # (spa_plugindir / 'bluez5'), so a future `momentum4 doctor` can read it
+  # from wherever the .so itself was found, no separate lookup needed.
+  # Guarded by fs.exists() so `meson setup` still works if someone points it
+  # at a patches-applied tree WITHOUT having run prepare-tree.sh's
+  # BUILD-INFO generation step (e.g. hand-applying the patches) -- this file
+  # is diagnostic metadata, never load-bearing for the plugin itself.
+  fs = import('fs')
+  if fs.exists('BUILD-INFO')
+    install_data('BUILD-INFO', install_dir : spa_plugindir / 'bluez5')
+  endif
 endif
 
 if ldac_dep.found()
