	"Таймаут `momentum4 mode` через ctl.sock.")
M4_CONF_KEY("cli", "player-timeout-ms", M4_CONF_T_INT, "2000", 100, 300000, NULL,
	"Timeout of `momentum4 player` over ctl.sock.",
	"Таймаут `momentum4 player` через ctl.sock.")
M4_CONF_KEY("cli", "repair-a2dp-timeout-ms", M4_CONF_T_INT, "40000", 100, 300000, NULL,
	"Overall timeout of `momentum4 repair-a2dp` (direct path, no daemon).",
	"Общий таймаут `momentum4 repair-a2dp` (прямой путь без демона).")
M4_CONF_KEY("cli", "repair-a2dp-poll-ms", M4_CONF_T_INT, "3000", 10, 60000, NULL,
	"EnumProfile poll period during `momentum4 repair-a2dp`.",
	"Период опроса EnumProfile во время `momentum4 repair-a2dp`.")
M4_CONF_KEY("cli", "status-timeout-ms", M4_CONF_T_INT, "700", 10, 60000, NULL,
	"Timeout for reading status directly from PipeWire in `momentum4 status`\n"
	"(no daemon, or after falling back).",
	"Таймаут прямого чтения статуса из PipeWire в `momentum4 status` (без демона или после фоллбэка).")
M4_CONF_KEY("cli", "status-poll-ms", M4_CONF_T_INT, "300", 10, 60000, NULL,
	"Timeout waiting for the daemon's reply over ctl.sock in `momentum4\n"
	"status`, before falling back to reading PipeWire directly.",
	"Таймаут ожидания ответа демона по ctl.sock в `momentum4 status`, до фоллбэка на прямое чтение PipeWire.")
