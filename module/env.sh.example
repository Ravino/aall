# env.sh -- local build environment for module.
#
# Copy this file to env.sh (gitignored, machine-local) and source it before
# running meson/ninja/gcc in this directory:
#   cp env.sh.example env.sh
#   source env.sh
#
# Paths below are computed relative to THIS file's location, so the
# defaults work for any checkout without editing -- copy as-is unless you
# keep the pkgconfig overlay / venv somewhere non-standard.
#
# What these are for:
#   PKG_CONFIG_PATH -- work/tools/root/pkgconfig-overlay/*.pc: hand-written
#     pkg-config files for optional bluez5 codec deps (ldac/lc3/opus/...)
#     whose -dev packages are not installed system-wide (apt-get download +
#     dpkg -x into work/, nothing installed into the system).
#   PATH -- work/venv/bin: a local Python virtualenv used by some of the
#     developer-only offline test/analysis tooling.

_ENV_SH_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_ENV_SH_REPO_ROOT="$(cd "$_ENV_SH_DIR/.." && pwd)"

export PKG_CONFIG_PATH="$_ENV_SH_REPO_ROOT/work/tools/root/pkgconfig-overlay:${PKG_CONFIG_PATH:-}"
export PATH="$_ENV_SH_REPO_ROOT/work/venv/bin:$PATH"

unset _ENV_SH_DIR _ENV_SH_REPO_ROOT
